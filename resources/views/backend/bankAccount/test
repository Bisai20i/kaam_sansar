    $(document).ready(function() {
      $('#sameAsPermanent').on('change', function() {
        if (this.checked) {
          // Copy values
          $('#temporaryCountry').val($('#permanentCountry').val());
          $('#temporaryProvince').val($('#permanentProvince').val());
          $('#temporaryDistrict').val($('#permanentDistrict').val());
